# Public application origin
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL. DATABASE_URL is used by the application and seed command.
# DIRECT_URL is optional and preferred by Prisma migrations when Supabase uses
# a pooled runtime connection. Keep both server-only.
DATABASE_URL=postgresql://tripfit:tripfit@localhost:5432/tripfit?schema=public
DIRECT_URL=

# Supabase Auth (introduced in Slice 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Feature flags
FEATURE_DATABASE_READS=false
FEATURE_DEMO_MODES=true
FEATURE_TRIP_PASS_PAYMENTS=false
FEATURE_EXTERNAL_PROVIDERS=false

# Calor product features. All values fail closed unless explicitly set to true.
# Only the public-launch state is safe to expose to the browser.
NEXT_PUBLIC_CALOR_PUBLIC_LAUNCH=false
CALOR_AFFILIATES_ENABLED=false
CALOR_PAYMENTS_ENABLED=false
CALOR_AI_RECOMMENDATIONS_ENABLED=false
CALOR_LIVE_MODE_ENABLED=false
CALOR_LOCAL_PARTNERS_ENABLED=false
CALOR_WEERZONE_REFERRAL_ENABLED=false
